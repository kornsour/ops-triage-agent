# ---------------------------------------------------------------------------
# ops-triage-agent configuration. Copy to `.env`. ALL values are optional —
# the system runs fully offline with the deterministic `mock` provider.
# ---------------------------------------------------------------------------

# LLM provider: mock | openai | anthropic
TRIAGE_LLM_PROVIDER=mock

# Model id (provider-specific). Ignored by the mock provider.
#   openai     -> e.g. gpt-4.1, gpt-4o, gpt-4o-mini
#   anthropic  -> e.g. claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5-20251001
TRIAGE_LLM_MODEL=

# Provider API keys (only needed when not using mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: hashing (offline, deterministic) | openai
TRIAGE_EMBEDDINGS_PROVIDER=hashing

# Enterprise controls
# Comma-separated api-key:role pairs for the MCP server / API auth.
# Roles: viewer (read-only), operator (can request actions), admin (can approve).
TRIAGE_API_KEYS=demo-operator-key:operator,demo-admin-key:admin,demo-viewer-key:viewer

# Cost/latency budgets (per triage run). The agent aborts if exceeded.
TRIAGE_MAX_USD_PER_RUN=0.05
TRIAGE_MAX_LATENCY_MS=15000
